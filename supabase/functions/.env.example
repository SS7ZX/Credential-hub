# Copy to supabase/functions/.env for local Edge Function serving only.
# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY.
# Never put real server values in VITE_* variables or commit a filled .env file.

# Must match the public site origin used by the local frontend.
PUBLIC_SITE_URL=http://localhost:5173

# Use the verified local/staging owner account email.
ISSUER_OWNER_EMAIL=

# Sandbox mail only. Use a test inbox and a sender permitted by your Resend setup.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_DAILY_PLAN_LIMIT=5
RESEND_SANDBOX=true
RESEND_SANDBOX_TO=

# Generate a random value for each environment; do not reuse across environments.
RATE_LIMIT_HASH_SECRET=

# Leave empty until issuing credentials. Generate and back up the key securely.
CREDENTIAL_SIGNING_KID=
CREDENTIAL_SIGNING_ALGORITHM=EdDSA
CREDENTIAL_SIGNING_KEY_PKCS8=
CREDENTIAL_SIGNING_PUBLIC_KEY_SPKI=
