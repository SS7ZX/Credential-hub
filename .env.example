# Frontend configuration. Vite exposes VITE_* values in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Supabase injects this into Edge Functions; never put a real value in Vite/client env.
SUPABASE_SERVICE_ROLE_KEY=
# Server-side Edge Function settings; configure in Supabase, not Vercel's VITE_* variables.
ISSUER_OWNER_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_DAILY_PLAN_LIMIT=
RESEND_SANDBOX=true
RESEND_SANDBOX_TO=
# Local: http://127.0.0.1:5173; staging: use the staging frontend URL.
PUBLIC_SITE_URL=
# Approved production issuer DID. Do not use it with a staging key unless its DID document
# resolves to that key; staging issuance needs a separately configured staging identity.
ORGANIZATION_DID=did:web:tasdiqapp.com
RATE_LIMIT_HASH_SECRET=
CREDENTIAL_SIGNING_KID=
CREDENTIAL_SIGNING_ALGORITHM=EdDSA
CREDENTIAL_SIGNING_KEY_PKCS8=
CREDENTIAL_SIGNING_PUBLIC_KEY_SPKI=
