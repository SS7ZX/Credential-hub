# Copy to .env.local. These are local frontend/build settings only.
# VITE_* values are public and will be included in the browser bundle.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy key name supported for older Supabase projects.
# VITE_SUPABASE_ANON_KEY=

# Public canonical origin used for credential links and the issuer DID.
# Local development only; set a real HTTPS origin in each deployment environment.
PUBLIC_SITE_URL=http://localhost:5173
